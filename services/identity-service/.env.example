SERVICE_NAME=identity-service
APP_ENV=local
GRPC_ADDR=:9101
DATABASE_URL=postgres://school_local:school_local_password@localhost:5432/identity_db?sslmode=disable

# Ed25519 PKCS#8 PEM. Keep private keys outside the repository.
JWT_PRIVATE_KEY_PATH=./secrets/jwt/private.pem
JWT_ISSUER=school-platform-identity
JWT_AUDIENCE=school-platform
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
