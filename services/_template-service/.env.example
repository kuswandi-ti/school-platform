# _template-service local environment
#
# These values are local-only examples. Do not use them in production.
# Production secrets must be injected via environment variables or a secrets manager.

SERVICE_NAME=_template-service
APP_ENV=local
HTTP_PORT=8081
# Optional full bind address. If set, this takes precedence over HTTP_PORT.
# HTTP_ADDR=:8081
GRPC_PORT=9081
LOG_LEVEL=debug
SHUTDOWN_TIMEOUT_SECONDS=10
DATABASE_URL=postgres://school_local:school_local_password@localhost:5432/template_service_db?sslmode=disable
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://school_local:school_local_password@localhost:5672/
