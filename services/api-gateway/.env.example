# api-gateway local environment
#
# These values are local-only examples. Do not use them in production.

SERVICE_NAME=api-gateway
APP_ENV=local
HTTP_PORT=8080
# Optional full bind address. If set, this takes precedence over HTTP_PORT.
# HTTP_ADDR=:8080
LOG_LEVEL=debug
SHUTDOWN_TIMEOUT_SECONDS=10
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Future internal gRPC targets. These are placeholders for Sprint 1+.
IDENTITY_GRPC_ADDR=localhost:9101
SCHOOL_CORE_GRPC_ADDR=localhost:9102
ADMISSION_GRPC_ADDR=localhost:9103
ACADEMIC_GRPC_ADDR=localhost:9104
FINANCE_GRPC_ADDR=localhost:9105
COMMUNICATION_GRPC_ADDR=localhost:9106
REPORTING_GRPC_ADDR=localhost:9107
