{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://school-platform.local/schemas/events/envelope.schema.json",
  "title": "DomainEventEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "source_service",
    "occurred_at",
    "correlation_id",
    "tenant",
    "entity",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z]+(\\.[a-z0-9_]+)+$",
      "examples": ["finance.payment.verified"]
    },
    "event_version": {
      "type": "integer",
      "minimum": 1
    },
    "source_service": {
      "type": "string",
      "examples": ["finance-service"]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "request_id": {
      "type": ["string", "null"]
    },
    "correlation_id": {
      "type": "string"
    },
    "actor": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["user_id", "role"],
          "properties": {
            "user_id": {
              "type": "string",
              "format": "uuid"
            },
            "role": {
              "type": "string"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "tenant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["foundation_id"],
      "properties": {
        "foundation_id": {
          "type": "string",
          "format": "uuid"
        },
        "school_id": {
          "type": ["string", "null"],
          "format": "uuid"
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_type", "entity_id"],
      "properties": {
        "entity_type": {
          "type": "string"
        },
        "entity_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "payload": {
      "type": "object"
    },
    "metadata": {
      "type": ["object", "null"]
    }
  }
}
