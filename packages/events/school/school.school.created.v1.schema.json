{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://school-platform.local/schemas/events/school.school.created.v1.schema.json",
  "title": "SchoolCreatedV1Payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["school_id", "school_code", "name", "school_level", "status"],
  "properties": {
    "school_id": { "type": "string", "format": "uuid" },
    "school_code": { "type": "string", "maxLength": 50 },
    "name": { "type": "string", "maxLength": 150 },
    "school_level": {
      "type": "string",
      "enum": ["kindergarten", "elementary", "junior_high", "senior_high"]
    },
    "status": { "type": "string", "enum": ["active", "inactive"] }
  }
}
