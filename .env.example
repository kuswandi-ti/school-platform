# school-platform local development environment
#
# These values are safe local-only examples.
# Do not use these credentials in staging or production.
# Copy this file to .env for local development:
#
#   cp .env.example .env

COMPOSE_PROJECT_NAME=school-platform

# PostgreSQL
POSTGRES_HOST_PORT=5432
POSTGRES_DB=school_platform_local
POSTGRES_USER=school_local
POSTGRES_PASSWORD=school_local_password

# Redis
REDIS_HOST_PORT=6379

# RabbitMQ
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=school_local
RABBITMQ_DEFAULT_PASS=school_local_password

# MinIO
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=school_local_minio
MINIO_ROOT_PASSWORD=school_local_minio_password

# Mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
