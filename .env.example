# school-platform local development environment
#
# These values are safe local-only examples.
# Do not use these credentials in staging or production.
# Production secrets must be injected through environment variables or a secrets manager.
# Copy this file to .env for local development:
#
#   cp .env.example .env

COMPOSE_PROJECT_NAME=school-platform

# PostgreSQL
POSTGRES_HOST_PORT=5432
POSTGRES_DB=school_platform_local
POSTGRES_USER=school_local
POSTGRES_PASSWORD=school_local_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Service database URLs for local development only.
# Services running on the host can use localhost.
IDENTITY_DATABASE_URL=postgres://school_local:school_local_password@localhost:5432/identity_db?sslmode=disable
SCHOOL_CORE_DATABASE_URL=postgres://school_local:school_local_password@localhost:5432/school_core_db?sslmode=disable
ADMISSION_DATABASE_URL=postgres://school_local:school_local_password@localhost:5432/admission_db?sslmode=disable
ACADEMIC_DATABASE_URL=postgres://school_local:school_local_password@localhost:5432/academic_db?sslmode=disable
FINANCE_DATABASE_URL=postgres://school_local:school_local_password@localhost:5432/finance_db?sslmode=disable
COMMUNICATION_DATABASE_URL=postgres://school_local:school_local_password@localhost:5432/communication_db?sslmode=disable
REPORTING_DATABASE_URL=postgres://school_local:school_local_password@localhost:5432/reporting_db?sslmode=disable

# Redis
REDIS_HOST_PORT=6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# RabbitMQ
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_HOST=localhost
RABBITMQ_DEFAULT_USER=school_local
RABBITMQ_DEFAULT_PASS=school_local_password
RABBITMQ_URL=amqp://school_local:school_local_password@localhost:5672/
RABBITMQ_MANAGEMENT_URL=http://localhost:15672

# MinIO
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=school_local_minio
MINIO_ROOT_PASSWORD=school_local_minio_password
MINIO_HOST=localhost
MINIO_ENDPOINT=http://localhost:9000
MINIO_CONSOLE_URL=http://localhost:9001

# Mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_HOST=localhost
MAILPIT_UI_HOST=localhost
MAILPIT_SMTP_URL=smtp://localhost:1025
MAILPIT_UI_URL=http://localhost:8025

# Optional local observability profile
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=school_local_admin
GRAFANA_ADMIN_PASSWORD=school_local_password
LOKI_PORT=3100
